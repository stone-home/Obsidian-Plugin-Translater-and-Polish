{
	"name": "translate-polish",
	"version": "1.1.0",
	"description": "Translate selected text and rewrite your writing as a native speaker, inside Obsidian.",
	"main": "src/main.js",
	"scripts": {
		"prepare": "husky",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"start": "node dist/index.js",
		"dev": "node esbuild.config.mjs",
		"test": "jest --passWithNoTests",
		"lint": "eslint .",
		"format": "prettier --write \"src/**/*.{ts,json,md}\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "stone",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.6",
		"builtin-modules": "^5.5.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"jiti": "^2.7.0",
		"lint-staged": "^17.6.0",
		"obsidian": "^1.14.4",
		"prettier": "^3.9.10",
		"semantic-release": "^25.0.9",
		"ts-jest": "^29.4.15",
		"tslib": "^2.9.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stone-home/Obsidian-Plugin-Translate-Code-Block.git"
	},
	"lint-staged": {
		"*.{ts,js,mjs,json,md}": [
			"prettier --write"
		]
	}
}
